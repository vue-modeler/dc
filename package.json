{
  "type": "module",
  "name": "@vue-modeler/di",
  "version": "2.2.0-v2-beta.7",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "description": "Dependency container based on VUE effected scope and shared composable.",
  "author": "abratko",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.17.0",
    "@vue/test-utils": "^1.3.6",
    "@vitest/coverage-v8": "2.1.9",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^9.32.0",
    "jsdom": "^25.0.1",
    "knip": "^6.14.2",
    "semantic-release": "^24.2.7",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "2.1.9",
    "vue": "^2.7"
  },
  "peerDependencies": {
    "vue": "^2.7"
  },
  "scripts": {
    "build": "tsc && vite build",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "semantic-release": "semantic-release",
    "knip": "knip",
    "lint": "eslint . --cache --cache-location ./node_modules/.vite/vite-plugin-eslint"
  },
  "knip": {
    "ignoreDependencies": [
      "@vitest/coverage-v8",
      "conventional-changelog-conventionalcommits"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vue-modeler/di.git"
  },
  "bugs": {
    "url": "https://github.com/vue-modeler/di/issues"
  },
  "packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
